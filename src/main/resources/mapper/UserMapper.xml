<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.tex.texapi.server.mapper.UserMapper">
        <insert id="register" parameterType="com.tex.texapi.pojo.dto.UserRegistryDTO">
            insert into user (name, user_name, password, phone, email) values
            (#{name}, #{userName}, #{password}, #{phone}, #{email});
        </insert>

</mapper>