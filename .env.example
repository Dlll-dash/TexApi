# ================================================================
# TexApi — 环境变量配置模板
# 使用方式：cp .env.example .env ，然后编辑 .env 填入你的密码
# ================================================================

# MySQL root 密码
DB_PASSWORD=your_mysql_password

# Redis 密码
REDIS_PASSWORD=your_redis_password

# 宿主机访问端口（默认 80，可改为其他端口如 8080）
APP_PORT=80
